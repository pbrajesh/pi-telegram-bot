# Copy of the settings the installer writes to /etc/tgbot.env.
# Real values go ONLY in /etc/tgbot.env on the Pi (chmod 600), never in git.

# Token from @BotFather
BOT_TOKEN=123456789:replace-with-your-token

# Comma-separated Telegram user IDs allowed to control the Pi
ALLOWED_IDS=111111111

# Leave empty for polling. For webhook mode, the full public URL incl. random path:
WEBHOOK_URL=
# Random string Telegram sends back in a header; generate with:
#   python3 -c 'import secrets;print(secrets.token_hex(32))'
WEBHOOK_SECRET=
# Local port the bot listens on in webhook mode (cloudflared -> localhost:PORT)
LISTEN_PORT=8081
